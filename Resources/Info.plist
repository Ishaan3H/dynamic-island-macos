<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Dynamic Island</string>
    <key>CFBundleDisplayName</key>
    <string>Dynamic Island</string>
    <key>CFBundleExecutable</key>
    <string>DynamicIsland</string>
    <key>CFBundleIdentifier</key>
    <string>com.qwerty.dynamicisland</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- Agent app: no Dock tile, no menu bar, no Cmd-Tab entry. -->
    <key>LSUIElement</key>
    <true/>

    <!--
      Automation (Apple Events). Shown verbatim in the TCC prompt the first time
      the app scripts Spotify. Required for artwork URLs and transport control.
    -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Dynamic Island uses Spotify’s scripting interface to read the current track and control playback from the island.</string>

    <!--
      Declared for completeness. The recording indicator reads the hardware
      "is running somewhere" flag and never opens a stream, so these prompts
      should not appear in normal use — but macOS requires the keys to exist
      before any code path could touch the devices.
    -->
    <key>NSCameraUsageDescription</key>
    <string>Dynamic Island checks whether the camera is in use so it can show a recording indicator. It never captures video.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Dynamic Island checks whether the microphone is in use so it can show a call indicator. It never records audio.</string>

    <!-- dynamicisland://call?name=…&app=…&phase=incoming -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.qwerty.dynamicisland.url</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>dynamicisland</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
