<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Dynamic Island</string>
    <key>CFBundleDisplayName</key>
    <string>Dynamic Island</string>
    <key>CFBundleExecutable</key>
    <string>DynamicIsland</string>
    <key>CFBundleIdentifier</key>
    <string>com.qwerty.dynamicisland</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- Agent app: no Dock tile, no menu bar, no Cmd-Tab entry. -->
    <key>LSUIElement</key>
    <true/>

    <!--
      Automation (Apple Events). Shown verbatim in the TCC prompt the first time
      the app scripts Spotify. Required for artwork URLs and transport control.
    -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Dynamic Island uses Spotify’s scripting interface to read the current track and control playback from the island.</string>

    <!--
      The camera is only ever *queried*, never opened: the recording indicator
      reads the hardware "is running somewhere" flag. This prompt should not
      appear in normal use, but the key must exist before any code path could
      touch the device.
    -->
    <key>NSCameraUsageDescription</key>
    <string>Dynamic Island checks whether the camera is in use so it can show a recording indicator. It never captures video.</string>

    <!--
      The microphone genuinely IS captured, for the voice assistant — so this
      string says so plainly. It previously claimed audio was never recorded,
      which stopped being true the moment dictation was added; a usage
      description is shown verbatim in the permission prompt, so an inaccurate
      one misleads the user at exactly the moment they are deciding.
    -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Dynamic Island records audio while you hold the voice shortcut, so it can turn what you say into a calendar event or open a vault. Audio is captured only while listening.</string>

    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Dynamic Island transcribes your voice commands on this Mac. Recognition runs on-device, so what you say is not sent to Apple or anywhere else.</string>

    <key>NSCalendarsUsageDescription</key>
    <string>Dynamic Island adds events you dictate to your calendar.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Dynamic Island adds events you dictate to your calendar, including calendars synced from accounts such as Google.</string>

    <!-- dynamicisland://call?name=…&app=…&phase=incoming -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.qwerty.dynamicisland.url</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>dynamicisland</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
